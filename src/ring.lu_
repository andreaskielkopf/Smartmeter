-- ringbuffer für Analyse von Dauer und Pegel des IR-Signals
-- IR ein sind positive Zahlen
-- IR aus sind negative Zahlen
do
   print 'load ring'
   M={}
   -- tabelle für den Ringtbuffer mit den Zeiten
   local buf={}
   -- zeiger und anderes
   local inp,out,max,overflow,overrun
   -- trägt die Zahl ein, wenn im puffer platz ist
   local function push(wert)      
--      if inp >= out+max then overflow=true end
      buf[inp%max+1]=wert -- ablegen
      inp=inp+1 -- increment zeiger
   end
   -- init
   local function init()
      print 'init ring'
      inp,out,max=0,0,500
      overflow,overrun=false,false
      for i=1,max do buf[i]=i end -- init array
--      for i=1,200 do push(i+100) end -- init array
   end
   -- holt eine zahl aus dem puffer oder nil
   local function pop()
      if inp <= out then -- es sind keine daten da
         return nil end
      if inp > out+max then
         out=inp-max -- reset ring soweit nötig
         return 'overflow' end -- buffer-überlauf signalisieren
      local erg=buf[out%max+1] -- holen
      out=out+1 -- increment zeiger
      return erg end
   -- eigener iterator
   local function ipop()
      local i = 0
      return function()
         i = i + 1
         local v = pop() --keys[i]
         if v then return i, v end
         return nil -- iterator beenden
      end end
   -- holt eine komplette textzeile mit bis zu 100 Zeiten ab
   local function get()
      local tmp={'leer'}
      for k,v in ipop() do tmp[k]=v end
      return table.concat(tmp,',') end

   init()
   M.push=push
   M.pop=pop
   M.get=get
   print 'end ring'
   return M
end
